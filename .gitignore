# --- Secrets. Nothing here is ever committed. ---
.env
.env.*
!.env.example
# A complete, deliberately-public demo config. Safe to ship: check-config
# refuses to pass with its values in place. See its own header.
!.env.demo

# The real content: questions, riddle, trophy names, closing message.
# Keeping it in one ignored file is what makes the later public scrub cheap.
config/run.yaml
config/*.local.yaml

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- Node ---
node_modules/
dist/
.vite/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/

# Leftover subagent worktrees from the build. Scratch, never content.
.claude/
