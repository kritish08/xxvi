# Copy to .env and fill in. .env is gitignored and never committed.
DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname
SESSION_SECRET=generate-with-openssl-rand-hex-32

# Hashes only.
#
# ACTIVATION_CODE_HASH is DIFFERENT from the rest. The web client
# (Activation.tsx) keeps TWO forms of what he types: it DISPLAYS
# XXXX-XXXX-XXXX in the input box, but it SUBMITS the bare twelve
# letters/digits with the dashes stripped (`canonicalKey`). So this hash
# must be of the UNDASHED 12-character form.
#
# An earlier version of this comment -- and of the CLI -- had that
# backwards and hashed the dashed form. The result is silent and total:
# the gate can never match, the front door does not lock so there is no
# lockout to clear, no operator bypass exists, and the UI just says the
# key is invalid forever. Verified in a real browser.
#
# Generate it with the dedicated mode, which normalises exactly the way
# the client does and prints BOTH forms so you can see which is hashed:
#   python -m xxvi.cli hash-secret --activation
#
# CHECKPOINT_{n}_HASH is free-form -- checkpoint codes are typed as-is, no
# client-side formatting. Generate with the plain mode:
#   python -m xxvi.cli hash-secret
#
# One CHECKPOINT_{n}_HASH per act boundary in config/run.yaml's `acts`
# count, one act short of the total (a 3-act config needs CHECKPOINT_1_HASH
# and CHECKPOINT_2_HASH but not a checkpoint after the final act -- the
# platinum reveal isn't gated by a code). Acts 1 and 2 are declared
# Settings fields for backward compatibility; anything beyond that is read
# straight from the environment as CHECKPOINT_3_HASH, CHECKPOINT_4_HASH,
# etc. `validate-config` and `assert_production_ready` both walk the real
# act count from config/run.yaml, so a missing hash for a configured act is
# caught rather than silently treated as an open gate.
ACTIVATION_CODE_HASH=
CHECKPOINT_1_HASH=
CHECKPOINT_2_HASH=

# Gift-card codes, one REWARD_{n}_CODE per reward in config/run.yaml's
# `rewards` list. Rewards 1 and 2 are declared Settings fields; a third
# reward reads REWARD_3_CODE straight from the environment the same way a
# third checkpoint does above. Dummy values below are fine until the codes
# are real -- see xxvi/settings.py's assert_production_ready, which refuses
# to release against a code shaped like one of these.
REWARD_1_CODE=DUMMY-REWARD-0001
REWARD_2_CODE=DUMMY-REWARD-0002

PLAYER_USERNAME=
PLAYER_PASSWORD_HASH=
OPERATOR_USERNAME=
OPERATOR_PASSWORD_HASH=

GO_LIVE_ISO=2026-08-20T00:00:00+05:30
DRY_RUN=false

# Caddy site address. MUST be set — empty makes Caddy fail to start.
SITE_DOMAIN=
