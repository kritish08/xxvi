# A COMPLETE, WORKING DEMO CONFIGURATION. Copy to .env and the stack runs:
#
#   cp .env.demo .env && docker compose up -d --build
#
# Every secret below is deliberately public and deliberately weak. This file
# exists so a stranger can play the demo in one command instead of running
# five hashing steps before seeing a single screen.
#
# It is SAFE to ship because it cannot be used for a real run by accident:
# `python -m xxvi.cli check-config` refuses to pass with these values in
# place (SESSION_SECRET is a recognised dev placeholder and the reward codes
# are the dummy sentinels), so the preflight that gates a real release fails
# loudly rather than letting a real gift ride on demo credentials.
#
# Credentials this file sets up:
#   player login     -> username `player`,   password `demo`
#   operator login   -> username `operator`, password `demo`
#   activation code  -> DEMO-1234-5678   (typed on the front door)
#   checkpoint codes -> DEMO             (both acts; the operator releases these)
#
# For a REAL run start from .env.example instead and generate your own.

# Matches the `db` service in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://xxvi:8nAOQZfo96YJWeiK3Lb5cz06w7rUgaZi@db:5432/xxvi

# Deliberately a recognised dev placeholder: `assert_production_ready`
# rejects anything starting with `dev-`, which is what stops this file from
# being usable for a real run.
SESSION_SECRET=dev-demo-only-never-use-this-for-a-real-run

ACTIVATION_CODE_HASH=$argon2id$v=19$m=65536,t=3,p=4$cq2kCbvyXI87L7Q/+rVpgw$Rv9YVT6CBWMLVWQ7uhiSGSEfY+TZ+aRA4t/4F4jEQ5c
# Hash of what the client actually sends: the BARE twelve characters
# DEMO12345678. The player sees DEMO-1234-5678 in the box; Activation.tsx
# strips the dashes before posting.

# Both checkpoint codes are the single word DEMO (gates uppercase input).
CHECKPOINT_1_HASH=$argon2id$v=19$m=65536,t=3,p=4$4ybCY0OF7h7AzhrVbBIpAw$qwig35zmmCBc5jF3vNBEKd6uPHIx6QikWMq+1mgrkxk
CHECKPOINT_2_HASH=$argon2id$v=19$m=65536,t=3,p=4$Oouj1VjYNCSvzWxa+u6WOg$JhrTklYq742E5ooJJUqkeStNNUObZTVBE8SLnwOI4oc

# The dummy sentinels. check-config refuses to release against these.
REWARD_1_CODE=DUMMY-REWARD-0001
REWARD_2_CODE=DUMMY-REWARD-0002

# Both passwords are the word: demo
PLAYER_USERNAME=player
PLAYER_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$m1bPfbt+yoXiJ2EFZJqupQ$t9xPbX+RaoXSUS2oREWmsWkp4BlkBJM7bnB8lBTkwkA
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$U8lOOqJkS3Q6m23/l9m8KA$ej+XMRmsb+CJgiHq60zq1E+d7yMiZpX3jefnG96twjc

# In the past, so the demo is live immediately with no countdown.
GO_LIVE_ISO=2020-01-01T00:00:00+05:30
DRY_RUN=false

# Plain HTTP on localhost. Deliberately NOT https: Caddy would mint a cert
# from its own internal CA and every browser would open the demo behind a
# full-page security warning. For a real deployment set a real domain here
# and Caddy provisions a genuine certificate automatically.
SITE_DOMAIN=http://localhost
